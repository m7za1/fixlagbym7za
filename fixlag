getgenv().Optimizer = {
    Originals = {
        Lighting = {
            GlobalShadows = Lighting.GlobalShadows,
            FogEnd = Lighting.FogEnd,
            FogStart = Lighting.FogStart
        },
        Effects = {},
        Particles = {}
    },
    Connections = {},
    State = {
        TargetFPS = 30
    }
}

Optimizer = getgenv().Optimizer

function Optimizer.LowGraphicsMode(enable)
    if Terrain then
        Terrain.WaterWaveSize = enable and 0 or 0.15
        Terrain.WaterWaveSpeed = enable and 0 or 10
        Terrain.WaterReflectance = enable and 0 or 1
        Terrain.WaterTransparency = enable and 0 or 1
    end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and not v:IsDescendantOf(lp.Character or Workspace) then
            if enable then v.Material = Enum.Material.SmoothPlastic end
        end
    end
end

function Optimizer.EffectCleaner()
    local count = 0
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Explosion") or v:IsA("Debris") or v.Name:lower():find("effect") or v.Name:lower():find("debris") then
            v:Destroy()
            count = count + 1
        end
    end
    return count
end

function Optimizer.ParticleOptimizer(enable)
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Sparkles") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Trail") or v:IsA("Beam") then
            if Optimizer.Originals.Particles[v] == nil then
                Optimizer.Originals.Particles[v] = v.Enabled
            end
            v.Enabled = not enable and Optimizer.Originals.Particles[v] or false
        end
    end
end

function Optimizer.CharacterOptimizer(enable)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            for _, item in ipairs(player.Character:GetDescendants()) do
                if item:IsA("Accessory") or item:IsA("ShirtGraphic") or item:IsA("Clothing") then
                    item.Parent = enable and nil or player.Character
                elseif item:IsA("BasePart") then
                    item.CastShadow = not enable
                end
            end
        end
    end
end

function Optimizer.DisableFog(enable)
    if enable then
        Lighting.FogEnd = 1e6
        Lighting.FogStart = 0
    else
        Lighting.FogEnd = Optimizer.Originals.Lighting.FogEnd
        Lighting.FogStart = Optimizer.Originals.Lighting.FogStart
    end
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") then
            v.Parent = enable and nil or Lighting
        end
    end
end

function Optimizer.LightingOptimizer(enable)
    Lighting.GlobalShadows = not enable and Optimizer.Originals.Lighting.GlobalShadows or false
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect") or v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect") then
            if Optimizer.Originals.Effects[v] == nil then
                Optimizer.Originals.Effects[v] = v.Enabled
            end
            v.Enabled = not enable and Optimizer.Originals.Effects[v] or false
        end
    end
end

function Optimizer.FPSMonitor(enable)
    if enable then
        if not fpsGui then
            fpsGui = Instance.new("ScreenGui")
            fpsGui.Name = "FPSGui"
            pcall(function() fpsGui.Parent = CoreGui end)
            if not fpsGui.Parent then fpsGui.Parent = lp:WaitForChild("PlayerGui") end
            
            fpsLabel = Instance.new("TextLabel")
            fpsLabel.Size = UDim2.new(0, 100, 0, 30)
            fpsLabel.Position = UDim2.new(1, -110, 0, 10)
            fpsLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            fpsLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
            fpsLabel.BackgroundTransparency = 0.3
            fpsLabel.Font = Enum.Font.SourceSansBold
            fpsLabel.TextSize = 16
            fpsLabel.Parent = fpsGui

            fpsCorner = Instance.new("UICorner")
            fpsCorner.CornerRadius = UDim.new(0, 8)
            fpsCorner.Parent = fpsLabel
        end
        fpsGui.Enabled = true
        local frames, last = 0, os.clock()
        Optimizer.Connections["FPS"] = RunService.RenderStepped:Connect(function()
            frames = frames + 1
            local now = os.clock()
            if now - last >= 1 then
                fpsLabel.Text = "FPS: " .. math.floor(frames / (now - last))
                frames = 0
                last = now
            end
        end)
    else
        if fpsGui then fpsGui.Enabled = false end
        if Optimizer.Connections["FPS"] then Optimizer.Connections["FPS"]:Disconnect() end
    end
end

function Optimizer.SmartCleanup()
    local count = Optimizer.EffectCleaner()
    for _, sound in ipairs(Workspace:GetDescendants()) do
        if sound:IsA("Sound") and not sound.IsPlaying then
            sound:Destroy()
            count = count + 1
        end
    end
    return count
end

function Optimizer.AutoOptimize(enable, targetFps)
    Optimizer.State.TargetFPS = targetFps or 30
    if enable then
        local frames, last = 0, os.clock()
        Optimizer.Connections["Auto"] = RunService.RenderStepped:Connect(function()
            frames = frames + 1
            local now = os.clock()
            if now - last >= 2 then
                local current = math.floor(frames / (now - last))
                if current < Optimizer.State.TargetFPS then
                    Optimizer.SmartCleanup()
                    Optimizer.LowGraphicsMode(true)
                    Optimizer.LightingOptimizer(true)
                end
                frames = 0
                last = now
            end
        end)
    else
        if Optimizer.Connections["Auto"] then Optimizer.Connections["Auto"]:Disconnect() end
    end
end

function Optimizer.PerformancePresets(preset)
    preset = tostring(preset):lower()
    if preset == "low" then
        Optimizer.LowGraphicsMode(true)
        Optimizer.ParticleOptimizer(true)
        Optimizer.CharacterOptimizer(true)
        Optimizer.DisableFog(true)
        Optimizer.LightingOptimizer(true)
    elseif preset == "medium" then
        Optimizer.LowGraphicsMode(false)
        Optimizer.ParticleOptimizer(true)
        Optimizer.CharacterOptimizer(false)
        Optimizer.DisableFog(true)
        Optimizer.LightingOptimizer(true)
    elseif preset == "high" then
        Optimizer.RestoreSettings()
    end
end

function Optimizer.PerformanceMode(enable)
    if enable then
        Optimizer.PerformancePresets("low")
        Optimizer.SmartCleanup()
    else
        Optimizer.RestoreSettings()
    end
end

function Optimizer.RestoreSettings()
    Optimizer.LowGraphicsMode(false)
    Optimizer.ParticleOptimizer(false)
    Optimizer.CharacterOptimizer(false)
    Optimizer.DisableFog(false)
    Optimizer.LightingOptimizer(false)
    Lighting.GlobalShadows = Optimizer.Originals.Lighting.GlobalShadows
    Lighting.FogEnd = Optimizer.Originals.Lighting.FogEnd
    Lighting.FogStart = Optimizer.Originals.Lighting.FogStart
    for effect, state in pairs(Optimizer.Originals.Effects) do
        if effect and effect.Parent then effect.Enabled = state end
    end
    for particle, state in pairs(Optimizer.Originals.Particles) do
        if particle and particle.Parent then particle.Enabled = state end
    end
end

Optimizer.PerformanceMode(true)
Optimizer.FPSMonitor(true)
Optimizer.AutoOptimize(true, 30)
